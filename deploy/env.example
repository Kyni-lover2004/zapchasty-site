SHOP_SECRET_KEY=GENERATE_A_RANDOM_SECRET
SHOP_DEBUG=0
SHOP_BEHIND_PROXY=1
SHOP_TRUSTED_PROXY_NETWORKS=127.0.0.1/32,::1/128
# Пустое значение: служебные страницы доступны только локально.
# Для VPN укажите конкретные адреса сотрудников также в allow-правилах Nginx.
SHOP_STAFF_NETWORKS=
SHOP_HOSTS=shop.example.ru
SHOP_ORIGINS=https://shop.example.ru
SHOP_MEDIA_ROOT=/srv/z62/media
SHOP_PUBLIC_URL=https://shop.example.ru
SHOP_MONITOR_URL=https://shop.example.ru/health/
# Уведомления владельцу отключены. Бот не принимает заказы покупателей.
SHOP_ALERTS_ENABLED=0
SHOP_TELEGRAM_TOKEN=
SHOP_TELEGRAM_CHAT_ID=
# Заполнить после выбора отдельного диска или хранилища, до включения backup.timer.
BACKUP_ROOT=
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=z62
PGUSER=z62
PGPASSWORD=SET_A_DATABASE_PASSWORD
